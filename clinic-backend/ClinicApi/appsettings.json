{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss.fff} {Level:u3}] [corr={CorrelationId}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/clinic-api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "rollOnFileSizeLimit": true,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz}] [{Level:u3}] [corr={CorrelationId}] [req={RequestId}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "EmailSettings": {
    "Region": "us-east-1",
    "SmtpHost": "email-smtp.us-east-1.amazonaws.com",
    "SmtpPort": 587,
    "SmtpUser": "YOUR_SMTP_USERNAME",
    "SmtpPass": "YOUR_SMTP_PASSWORD",
    "From": "noreply@yourdomain.com"
  },
   "ConnectionStrings": {
    "clinicDbConnection": "Host=localhost;Port=5433;Database=clinic_db;Username=clinic_backend_user;Password=pD7pr;"
  }
}
